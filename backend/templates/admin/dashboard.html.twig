{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}

<div style="padding: 1rem 0;">

    <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1.75rem;">
        <h1 style="font-size: 22px; font-weight: 600; color: #1e293b; margin: 0;">
            Honey Group CMS
        </h1>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; width: 100%;">

        <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.1rem 1.2rem;">
            <div style="width:34px; height:34px; background:#EEEDFE; border-radius:8px; display:flex; align-items:center; justify-content:center; margin-bottom:10px;">
                <svg width="17" height="17" fill="none" stroke="#534AB7" stroke-width="1.6" viewBox="0 0 24 24"><path d="M3 12h4l3-9 4 18 3-9h4"/></svg>
            </div>
            <p style="font-size:26px; font-weight:600; color:#1e293b; margin:0 0 4px;">{{ circuits }}</p>
            <p style="font-size:12px; color:#64748b; margin:0;">Circuits</p>
        </div>

        <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.1rem 1.2rem;">
            <div style="width:34px; height:34px; background:#E6F1FB; border-radius:8px; display:flex; align-items:center; justify-content:center; margin-bottom:10px;">
                <svg width="17" height="17" fill="none" stroke="#185FA5" stroke-width="1.6" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
            </div>
            <p style="font-size:26px; font-weight:600; color:#1e293b; margin:0 0 4px;">{{ prestations }}</p>
            <p style="font-size:12px; color:#64748b; margin:0;">Prestations</p>
        </div>

        <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.1rem 1.2rem;">
            <div style="width:34px; height:34px; background:#E1F5EE; border-radius:8px; display:flex; align-items:center; justify-content:center; margin-bottom:10px;">
                <svg width="17" height="17" fill="none" stroke="#0F6E56" stroke-width="1.6" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            </div>
            <p style="font-size:26px; font-weight:600; color:#1e293b; margin:0 0 4px;">{{ photos }}</p>
            <p style="font-size:12px; color:#64748b; margin:0;">Photos</p>
        </div>

        <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.1rem 1.2rem;">
            <div style="width:34px; height:34px; background:#FAEEDA; border-radius:8px; display:flex; align-items:center; justify-content:center; margin-bottom:10px;">
                <svg width="17" height="17" fill="none" stroke="#854F0B" stroke-width="1.6" viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            </div>
            <p style="font-size:26px; font-weight:600; color:#1e293b; margin:0 0 4px;">{{ formations }}</p>
            <p style="font-size:12px; color:#64748b; margin:0;">Formations</p>
        </div>

        <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.1rem 1.2rem;">
            <div style="width:34px; height:34px; background:#FCEBEB; border-radius:8px; display:flex; align-items:center; justify-content:center; margin-bottom:10px;">
                <svg width="17" height="17" fill="none" stroke="#A32D2D" stroke-width="1.6" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <p style="font-size:26px; font-weight:600; color:#1e293b; margin:0 0 4px;">{{ users }}</p>
            <p style="font-size:12px; color:#64748b; margin:0;">Admin</p>
        </div>

    </div>
</div>

{% endblock %}